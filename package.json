{
  "name": "alchemy-deploy",
  "version": "3.1.1",
  "description": "Secure reusable GitHub deployment workflow and reporting action for Alchemy on Cloudflare",
  "license": "MIT",
  "files": [
    "actions",
    "assets",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/domain/deployment.ts",
    "./worker-preview-artifact": "./src/worker-preview-artifact.ts"
  },
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run typecheck && bun test && bun run check && bun run validate:metadata && bun run validate:runtime && bun run validate:changesets",
    "validate:changesets": "bun scripts/validate-changesets.ts",
    "validate:metadata": "bun scripts/validate-metadata.ts",
    "validate:runtime": "bun scripts/validate-runtime.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/platform-node-shared": "4.0.0-rc.117",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.117",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.117"
  },
  "packageManager": "bun@1.4.2"
}
